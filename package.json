{
  "name": "@marl1w/scrypted-patrol",
  "version": "0.1.4",
  "description": "Scrypted plugin: one virtual camera that patrols a set of cameras in turn and cuts to the one with an event, as a single continuous stream with its own motion, occupancy and sensors.",
  "license": "Apache-2.0",
  "scripts": {
    "scrypted-setup-project": "scrypted-setup-project",
    "prescrypted-setup-project": "scrypted-package-json",
    "build": "scrypted-webpack",
    "prepublishOnly": "NODE_ENV=production scrypted-webpack",
    "scrypted-deploy": "scrypted-deploy",
    "scrypted-deploy-debug": "scrypted-deploy-debug",
    "scrypted-debug": "scrypted-debug",
    "scrypted-package-json": "scrypted-package-json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js"
  },
  "keywords": [
    "scrypted",
    "plugin",
    "camera",
    "patrol",
    "round robin"
  ],
  "scrypted": {
    "rollup": true,
    "name": "Patrol",
    "type": "DeviceProvider",
    "interfaces": [
      "DeviceProvider",
      "DeviceCreator"
    ],
    "pluginDependencies": []
  },
  "dependencies": {
    "@scrypted/sdk": "^0.5.59"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.6.0"
  },
  "author": "marl1w",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/marl1w/scrypted-patrol.git"
  },
  "homepage": "https://github.com/marl1w/scrypted-patrol#readme",
  "bugs": {
    "url": "https://github.com/marl1w/scrypted-patrol/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
